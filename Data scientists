import React, { useEffect, useState } from "react";
import axios from "axios";
import { Line } from "react-chartjs-2";

const StockChart = () => {
  const [stockData, setStockData] = useState([]);
  const API_KEY = "YOUR_ALPHAVANTAGE_API_KEY";
  const STOCK_SYMBOL = "AAPL";

  useEffect(() => {
    axios
      .get(
        `https://www.alphavantage.co/query?function=TIME_SERIES_DAILY&symbol=${STOCK_SYMBOL}&apikey=${API_KEY}`
      )
      .then((response) => {
        const data = response.data["Time Series (Daily)"];
        const dates = Object.keys(data).slice(0, 30).reverse();
        const prices = dates.map((date) => data[date]["4. close"]);
        setStockData({ dates, prices });
      });
  }, []);

  return (
    <div>
      <h2>Stock Prices for {STOCK_SYMBOL}</h2>
      <Line
        data={{
          labels: stockData.dates,
          datasets: [{ label: "Closing Price", data: stockData.prices, borderColor: "blue" }],
        }}
      />
    </div>
  );
};

export default StockChart;
